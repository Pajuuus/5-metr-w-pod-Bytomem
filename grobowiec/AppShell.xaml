<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="grobowiec.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:grobowiec"
    FlyoutWidth="150"
    FlyoutBackgroundColor="#1B1428"
    Title="grobowiec">

    <TabBar x:Name="AppTabBar" CurrentItem="{x:Reference MainTab}">
        <Tab Title="Koszyk" Icon="test.svg">
            <ShellContent
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="Koszyk" />
        </Tab>

        <Tab x:Name="MainTab" Title="Main" Icon="dotnet_bot.png">
            <ShellContent
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="Profil" Icon="test.svg">
            <ShellContent
                ContentTemplate="{DataTemplate local:TestPage}"
                Route="TestPage" />
        </Tab>
    </TabBar>

</Shell>

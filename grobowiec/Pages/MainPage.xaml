<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="grobowiec.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="16">

            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                    <Label Text="Witaj,"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding User.Username}"
                           FontAttributes="Bold"
                           Style="{StaticResource Headline}" />
                </HorizontalStackLayout>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#1F1F1F"
                        Stroke="#383838"
                        Padding="10,6"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{Binding User.Souls, StringFormat='Dusze: {0}'}"
                               TextColor="#A78BFA"
                               FontAttributes="Bold"
                               FontSize="14"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <BoxView HeightRequest="1"
                     Color="#404040"
                     HorizontalOptions="Fill" />

            <Label Text="Dzienne promocje"
                   FontSize="16"
                   FontAttributes="Bold"
                   Style="{StaticResource SubHeadline}"
                   SemanticProperties.HeadingLevel="Level2" />

            <CollectionView ItemsSource="{Binding DailyPromos}"
                            HeightRequest="180"
                            HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="#404040"
                                StrokeThickness="1"
                                BackgroundColor="#262626"
                                WidthRequest="180"
                                Padding="12"
                                Margin="2">

                            <VerticalStackLayout Spacing="8">
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="90"
                                       WidthRequest="156" />

                                <Label Text="{Binding Title}"
                                       TextColor="#E0E0E0"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />

                                <HorizontalStackLayout Spacing="8" VerticalOptions="End">
                                    <Label Text="{Binding PromoPrice}"
                                           TextColor="#4ADE80"
                                           FontAttributes="Bold"
                                           FontSize="14" />
                                    <Label Text="{Binding OldPrice}"
                                           TextColor="#888888"
                                           TextDecorations="Strikethrough"
                                           FontSize="11"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1"
                     Color="#404040"
                     HorizontalOptions="Fill" />

            <Border x:Name="eee"
                StrokeShape="RoundRectangle 10"
                    Stroke="#DC2626"
                    BackgroundColor="#2A1515"
                    Padding="16"
                    Margin="0,4">
                <VerticalStackLayout Spacing="4">
                    <Label Text="TYLKO DO KOŃCA TYGODNIA!"
                           TextColor="#F87171"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           SemanticProperties.HeadingLevel="Level3" />
                    <Label Text="WSZYSTKIE KREMACJE -20%"
                           TextColor="#FFFFFF"
                           FontSize="16"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
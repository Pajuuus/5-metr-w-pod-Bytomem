<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="grobowiec.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <HorizontalStackLayout
                Spacing="6">
                <Label
                    Text="Witaj,"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="Marcin!"
                    FontAttributes="Bold"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1" />
            </HorizontalStackLayout>
            
            <BoxView HeightRequest="1"
                     Color="#808080"
                     HorizontalOptions="Fill"
                     Margin="0,8" />
            
            <Label
                Text="Dzienne promocje"
                FontSize="15"
                Style="{StaticResource Headline}"
                HorizontalOptions="Start"
                HorizontalTextAlignment="Start"
                SemanticProperties.HeadingLevel="Level1" />
            
            <CollectionView ItemsSource="{Binding DailyPromos}"
                            HeightRequest="190"
                            HorizontalScrollBarVisibility="Never"
                            >
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"
                                       ItemSpacing="14" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                BackgroundColor="#2B2B2B"
                                WidthRequest="140"
                                Margin="4">
                            <VerticalStackLayout Spacing="6" Padding="8">
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="95"
                                       WidthRequest="170" />

                                <Label Text="{Binding Title}"
                                       TextColor="White"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding PromoPrice}"
                                           TextColor="#61507D"
                                           FontSize="13"/>
                                    <Label Text="{Binding OldPrice}"
                                           TextColor="#888888"
                                           FontSize="11"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <BoxView HeightRequest="1"
                     Color="#808080"
                     HorizontalOptions="Fill"
                     Margin="0,8" />
            
            <Label
                Text="TYLKO DO KONCA TYGODNIA!!"
                FontSize="18"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="WSZYSTKIE KREMACJE -20%"
                FontSize="15"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level1" />
            
            <BoxView HeightRequest="1"
                     Color="#808080"
                     HorizontalOptions="Fill"
                     Margin="0,8" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
